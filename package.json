{
  "name": "FantasticFrame",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun scripts/fetch-fonts.mjs && nuxt typecheck && nuxt build && bun scripts/postbuild.mjs",
    "dev": "bun scripts/fetch-fonts.mjs && nuxt dev",
    "fonts": "bun scripts/fetch-fonts.mjs",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "oxlint .",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.1",
    "exifr": "^7.1.3",
    "fflate": "^0.8.3",
    "nuxt": "^4.6.2",
    "takumi-js": "^2.5.4",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@iconify-json/lucide": "^1.2.147",
    "@types/bun": "latest",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.76.0",
    "tailwindcss": "^4",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  },
  "allowScripts": {}
}
